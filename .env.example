# Copiar a .env para desarrollo local. Valores solo de ejemplo: nunca usar en producción.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=policies
# Para correr el orquestador fuera de Docker:
DATABASE_URL=postgres://app:change-me@localhost:5433/policies?sslmode=disable
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://app:change-me@localhost:5672/
TEST_RABBITMQ_URL=amqp://app:change-me@localhost:5672/
# Pruebas de integración: base separada (debe terminar en _test; las pruebas vacían sus tablas)
TEST_DATABASE_URL=postgres://app:change-me@localhost:5433/policies_test?sslmode=disable
# Login de la consola (HU-05). Obligatorios y sin valor de ejemplo a propósito: un valor copiado tal cual
# dejaría la firma de los tokens y la contraseña del primer operador a la vista de cualquiera.
# JWT_SECRET: mínimo 32 bytes, p. ej. el resultado de `openssl rand -hex 32`.
JWT_SECRET=
# Primer operador de la consola (se crea al iniciar si no existe; contraseña de 12 caracteres o más).
OPS_BOOTSTRAP_USER=ana.perez
OPS_BOOTSTRAP_NAME=Ana Pérez
OPS_BOOTSTRAP_PASSWORD=
# Reconciliación: una orden sin avanzar más de STUCK_AFTER se considera atascada; el job corre cada RECONCILE_EVERY.
STUCK_AFTER=5m
RECONCILE_EVERY=1m
